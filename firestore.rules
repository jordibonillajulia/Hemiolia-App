rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'info@hemiolia.cat' || 
         request.auth.token.email == 'admin@hemiolia.cat' || 
         request.auth.token.email == 'jordibonillajulia@gmail.com' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if the user has CRM access
    function isCrmAgent() {
      return request.auth != null && 
        (request.auth.token.email == 'unaonadapetitona@gmail.com' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'crm');
    }

    // Users collection: users can read/write their own document (excluding role updates), admins can read/write all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isCrmAgent());
      allow write: if request.auth != null && (
        isAdmin() || 
        (
          request.auth.uid == userId && 
          (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'viewer') &&
          (!exists(/databases/$(database)/documents/users/$(userId)) || request.resource.data.role == resource.data.role)
        )
      );
    }

    // Gigs (Road-sheet) read access is restricted to CRM agents and admins to protect sensitive data.
    // The public website gets filtered public gigs via the secure /api/public/gigs API route.
    match /gigs/{gigId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }

    // CRM / Contacts and Interactions: read and write for Admin and CRM Agent
    match /contacts/{contactId} {
      allow read, write: if isAdmin() || isCrmAgent();
    }
    match /interactions/{interactionId} {
      allow read, write: if isAdmin() || isCrmAgent();
    }

    // Other private collections: read-only for CRM Agent, full access for Admin
    match /shows/{showId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /clients_billing/{clientId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /products_billing/{productId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /budgets/{budgetId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /ledgers_issued/{ledgerId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }
    match /ledgers_received/{ledgerId} {
      allow read: if isAdmin() || isCrmAgent();
      allow write: if isAdmin();
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
